@* Monoline SVG icon set (Lucide/Feather vocabulary). Colour comes from currentColor.
   Usage: <Icon Name="home" />  ·  <Icon Name="bookmark" Fill="currentColor" /> *@
<svg class="sm-ico @Class" viewBox="0 0 24 24" fill="@Fill" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
     style="@SizeStyle">
    @((MarkupString)Paths(Name))
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string StrokeWidth { get; set; } = "1.9";
    [Parameter] public string Fill { get; set; } = "none";
    [Parameter] public int? Size { get; set; }

    private string? SizeStyle => Size is int s ? $"width:{s}px;height:{s}px" : null;

    private static string Paths(string? name) => (name ?? "").Trim().ToLowerInvariant() switch
    {
        "home" => "<path d='M3 10.5 12 3l9 7.5'/><path d='M5 9.5V21h14V9.5'/><path d='M9.5 21v-6h5v6'/>",
        "grid" => "<rect x='3' y='3' width='7' height='7' rx='1.5'/><rect x='14' y='3' width='7' height='7' rx='1.5'/><rect x='14' y='14' width='7' height='7' rx='1.5'/><rect x='3' y='14' width='7' height='7' rx='1.5'/>",
        "plus" => "<path d='M12 5v14M5 12h14'/>",
        "bookmark" => "<path d='M6 4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17l-6-4-6 4z'/>",
        "user" => "<circle cx='12' cy='8' r='4'/><path d='M4 21c0-4 3.6-6 8-6s8 2 8 6'/>",
        // Symmetric about x=12. Every segment is an explicit cubic — a leading 's' has no
        // previous curve to mirror, so its first control point collapses onto the tip and
        // flattens the bottom-left edge.
        "heart" => "<path d='M12 20.9C7.5 17.5 2.5 13.5 2.5 9.1 2.5 5.8 5.1 3.4 8.1 3.4 10.1 3.4 11.3 4.8 12 6.1 12.7 4.8 13.9 3.4 15.9 3.4 18.9 3.4 21.5 5.8 21.5 9.1 21.5 13.5 16.5 17.5 12 20.9Z'/>",
        "message-circle" => "<path d='M21 11.5a8.4 8.4 0 0 1-11.6 7.8L3 21l1.8-6.4A8.5 8.5 0 1 1 21 11.5Z'/>",
        "send" => "<path d='M22 3 2 10.5l7 2.5 2.5 7L22 3Z'/><path d='M9 13 22 3'/>",
        "more-horizontal" => "<circle cx='5' cy='12' r='1.6'/><circle cx='12' cy='12' r='1.6'/><circle cx='19' cy='12' r='1.6'/>",
        "flame" => "<path d='M12 2c1 3-1.5 4.5-1.5 7A2.5 2.5 0 0 0 13 11c1.5 0 2-1 2-1 .8 1 2 2.4 2 4.8A5 5 0 0 1 12 20a5 5 0 0 1-5-5c0-4 3-5 5-13Z'/>",
        // Two crossing paths with their own arrowheads, symmetric about y=12. The older X-shaped
        // Feather shuffle lost its arrowheads at 24px and read as a close button.
        "shuffle" => "<path d='M3 7h2.5c1.3 0 2.5.6 3.3 1.7l5.4 6.6c.8 1.1 2 1.7 3.3 1.7H21'/><path d='M3 17h2.5c1.3 0 2.5-.6 3.3-1.7l5.4-6.6c.8-1.1 2-1.7 3.3-1.7H21'/><path d='m18 4 3 3-3 3'/><path d='m18 14 3 3-3 3'/>",
        "chevron-down" => "<path d='m6 9 6 6 6-6'/>",
        "chevron-left" => "<path d='m15 6-6 6 6 6'/>",
        "chevron-right" => "<path d='m9 6 6 6-6 6'/>",
        "lock" => "<rect x='4' y='10' width='16' height='11' rx='2'/><path d='M8 10V7a4 4 0 0 1 8 0v3'/>",
        "menu" => "<path d='M4 7h16M4 12h16M4 17h16'/>",
        "settings" => "<path d='M4 6h9M18 6h2M4 12h4M11 12h9M4 18h13M20 18h0'/><circle cx='15' cy='6' r='2'/><circle cx='7' cy='12' r='2'/><circle cx='16' cy='18' r='2'/>",
        "upload" => "<path d='M12 16V4M7 9l5-5 5 5'/><path d='M5 20h14'/>",
        "search" => "<circle cx='11' cy='11' r='7'/><path d='m20 20-3.2-3.2'/>",
        "book-open" => "<path d='M12 6.5C10.5 5 8 4.5 5 4.5V19c3 0 5.5.5 7 2 1.5-1.5 4-2 7-2V4.5c-3 0-5.5.5-7 2z'/><path d='M12 6.5V21'/>",
        "trash" => "<path d='M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13'/>",
        "eye" => "<path d='M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z'/><circle cx='12' cy='12' r='3'/>",
        "eye-off" => "<path d='M4 4l16 16'/><path d='M9.9 5.2A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a19 19 0 0 1-2.8 3.6M6.4 7.5A19 19 0 0 0 2 12s3.6 7 10 7a10 10 0 0 0 3.4-.6'/>",
        "play" => "<path d='M8 5.2v13.6L19 12z'/>",
        "external-link" => "<path d='M14 4h6v6'/><path d='M20 4 11.5 12.5'/><path d='M18 14.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4.5'/>",
        "x" => "<path d='M18 6 6 18M6 6l12 12'/>",
        "dice" => "<rect x='3' y='3' width='18' height='18' rx='3.5'/><circle cx='8.5' cy='8.5' r='1.35' fill='currentColor' stroke='none'/><circle cx='12' cy='12' r='1.35' fill='currentColor' stroke='none'/><circle cx='15.5' cy='15.5' r='1.35' fill='currentColor' stroke='none'/>",
        "check" => "<path d='m20 6-11 11-5-5'/>",
        "pencil" => "<path d='M12 20h9'/><path d='M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z'/>",
        "tag" => "<path d='M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9-9-9Z'/><circle cx='7.5' cy='7.5' r='1.4'/>",
        // Pausing a book, not powering a device — but the symbol is the one everyone already reads
        // as on/off, and the label next to it says which.
        "power" => "<path d='M12 3v9'/><path d='M18.4 6.6a9 9 0 1 1-12.8 0'/>",
        "sparkles" => "<path d='M10.5 3c.9 3.4 1.6 4.1 5 5-3.4.9-4.1 1.6-5 5-.9-3.4-1.6-4.1-5-5 3.4-.9 4.1-1.6 5-5Z'/><path d='M17.8 13.6c.5 1.9.9 2.3 2.7 2.7-1.8.5-2.2.9-2.7 2.7-.5-1.8-.9-2.2-2.7-2.7 1.8-.4 2.2-.8 2.7-2.7Z'/>",
        _ => "<circle cx='12' cy='12' r='2'/>",
    };
}
